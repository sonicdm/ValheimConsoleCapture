<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <AssemblyName>ValheimConsoleCapture</AssemblyName>
    <RootNamespace>ValheimConsoleCapture</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Full Windows PDB: ScriptEngine (Mono.Cecil) needs a .pdb beside the DLL. -->
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <ValheimLibDir Condition="'$(ValheimLibDir)' == ''">E:\Scripts\Valheim Mods\Reqs</ValheimLibDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(ValheimLibDir)\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateValheimLibDir" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ValheimLibDir)')" Text="Valheim library directory not found: $(ValheimLibDir)" />
  </Target>
</Project>
